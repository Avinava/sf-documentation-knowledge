# SF Documentation Knowledge - Environment Configuration
# Copy to .env and fill in values

# Logging
LOG_LEVEL=info

# Collection settings
COLLECTION_RATE_LIMIT_MS=500
COLLECTION_RETRY_COUNT=3

# MCP Server: Domain Restriction
# Restrict all MCP tools to specific domains (comma-separated domain IDs).
# When not set, all 129 domains are active (default behavior).
# Use sf_suggest_domains at runtime to discover relevant domain IDs.
# See docs/domains.md for the full list of domain IDs.
# SF_ACTIVE_DOMAINS=revenue-cloud,clm-developer-guide,blng-dev
